LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=REPLACE_ME
SERVICE_TOKENS=REPLACE_ME_TOKEN_1,REPLACE_ME_TOKEN_2
LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_FALLBACK_2=google/gemma-4-26b-a4b-it
ADMIN_TOKEN=REPLACE_ME
DAILY_QUOTA=80
DATA_PATH=/tmp/proovixy/store.json
MAX_TEXT_CHARS=200
MAX_EXTRAS_CHARS=500
MAX_DEVICES_PER_TOKEN=3
TIMESTAMP_SKEW=120
NONCE_TTL_SECONDS=300
REQUIRE_HTTPS=true
TRUST_PROXY=true
MAX_REQUEST_BODY_BYTES=8192
ADMIN_LOGIN_RATE_LIMIT=10
ADMIN_LOGIN_RATE_WINDOW_SECONDS=300
API_RATE_LIMIT=120
API_RATE_WINDOW_SECONDS=60
ADMIN_REDACT_SENSITIVE=true
LLM_CHAT_PATH=/chat/completions
LLM_TIMEOUT_SECONDS=40
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.15
LLM_TEMPERATURE_EXPAND=0.4
LLM_MODEL_STATUS_TTL_SECONDS=60
ADMIN_COOKIE_MAX_AGE_SECONDS=43200
ADMIN_EVENT_LOG_SIZE=1000
ADMIN_LOG_DISPLAY_LIMIT=250
